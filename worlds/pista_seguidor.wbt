  ]
  name "SEGUIDOR_LINHA"
  boundingObject Transform {
    translation 0 0 0.015
    children [
      Box {
        size 0.15 0.08 0.012
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.35
    centerOfMass [
      0 0 0.005
    ]
  }
  controller "seguidor_linha"
}
