                  baseColor 0.2 0.2 0.2
                  roughness 0.5
                }
                geometry Cylinder {
                  height 0.018
                  radius 0.005
                }
              }
            ]
          }
        ]
        name "roda_traseira_dir"
        contactMaterial "roda_traseira"
        boundingObject Transform {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.016
              radius 0.025
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.04
        }
      }
    }

    # 3. RODA DIANTEIRA ESQUERDA (Apoio livre com rolagem)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.045 0.055 0
      }
      endPoint Solid {
        translation 0.045 0.055 0
        children [
          Transform {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.15 0.15 0.15
                  roughness 0.8
                }
                geometry Cylinder {
                  height 0.016
                  radius 0.025
                }
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.85 0.85 0.85
                  roughness 0.3
                  metalness 0.5
                }
                geometry Cylinder {
                  height 0.017
                  radius 0.015
                }
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.2 0.2 0.2
                  roughness 0.5
                }
                geometry Cylinder {
                  height 0.018
                  radius 0.005
                }
              }
            ]
          }
        ]
        name "roda_dianteira_esq"
        contactMaterial "roda_dianteira"
        boundingObject Transform {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.016
              radius 0.025
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.04
        }
      }
    }

    # 4. RODA DIANTEIRA DIREITA (Apoio livre com rolagem)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.045 -0.055 0
      }
      endPoint Solid {
        translation 0.045 -0.055 0
        children [
          Transform {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.15 0.15 0.15
                  roughness 0.8
                }
                geometry Cylinder {
                  height 0.016
                  radius 0.025
                }
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.85 0.85 0.85
                  roughness 0.3
                  metalness 0.5
                }
                geometry Cylinder {
                  height 0.017
                  radius 0.015
                }
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.2 0.2 0.2
                  roughness 0.5
                }
                geometry Cylinder {
                  height 0.018
                  radius 0.005
                }
              }
            ]
          }
        ]
        name "roda_dianteira_dir"
        contactMaterial "roda_dianteira"
        boundingObject Transform {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.016
